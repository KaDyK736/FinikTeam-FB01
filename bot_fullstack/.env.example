# Токен от @BotFather — сюда же кладётся в файл .env, в архив не входит
TOKEN=

# Локальная база: по умолчанию sqlite-файл рядом с app.py
DB_URL=sqlite+aiosqlite:///fb01_bot.db
# DB_ECHO=1        # логировать SQL-запросы

# Номер телефона наставника — через запятую несколько. Именно номер даёт доступ
# к карточкам клиентов; telegram_id подставится сам, когда человек пришлёт номер боту.
# Если тот же номер есть в выгрузке сайта, человек считается клиентом: список
# наставников доступа не даёт.
MENTOR_PHONE=

# Настоящий номер одного клиента (карточка F001), чтобы проверить сверку телефона
# и уведомление «наставник готов помочь». Не заполните — возьмётся MENTOR_PHONE;
# не укажите вовсе — F001 останется с вымышленным номером из кейса.
DEMO_PHONE=
# Telegram-id администратора учебного стенда (загружает события регистрации)
ADMIN_TG_ID=

# Ссылка, которую бот даёт человеку без анкеты на сайте, чтобы он зарегистрировался
# (номер пригласившего в URL). По умолчанию — значение из database/site_export.py.
# REGISTER_URL=https://faberlic.com/ru/ru?sponsornumber=000000000

# Папка с учебными данными кейса, если она не рядом с кодом
# CASE_DATA_DIR=02_Учебные_данные
