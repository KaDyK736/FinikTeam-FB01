# Токен от @BotFather — сюда же кладётся в файл .env, в архив не входит
TOKEN=

# Локальная база: по умолчанию sqlite-файл рядом с app.py
DB_URL=sqlite+aiosqlite:///fb01_bot.db
# DB_ECHO=1        # логировать SQL-запросы

# Номер телефона наставника — через запятую несколько. Именно номер даёт доступ
# к карточкам клиентов; telegram_id подставится сам, когда человек пришлёт номер боту.
MENTOR_PHONE=
# Telegram-id администратора учебного стенда (загружает события регистрации)
ADMIN_TG_ID=

# Папка с учебными данными кейса, если она не рядом с кодом
# CASE_DATA_DIR=02_Учебные_данные
