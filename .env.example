# Скопируйте этот файл в .env и заполните значения. .env в репозиторий не попадает.

# Telegram
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Telegram id наставников через запятую или точку с запятой; пусто — режим наставника выключен
MENTOR_USER_IDS=

# Локальная база карточек (SQLite)
DB_LITE=sqlite+aiosqlite:///./my_base.db
DB_ECHO=0
DB_RESET=0

# LLM: любой OpenAI-совместимый эндпоинт. Локальная Ollama ключа не требует.
# Ollama:   LLM_BASE_URL=http://localhost:11434/v1, LLM_API_KEY можно оставить пустым
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b-instruct
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=900
LLM_TIMEOUT=90
LLM_MAX_RETRIES=0
LLM_RATE_ATTEMPTS=5
LLM_RATE_DELAY=15
LLM_PARSE_ATTEMPTS=3
